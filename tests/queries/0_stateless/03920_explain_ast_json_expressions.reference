-- literal value types
[{"value_type":"Array","value":"[1, 2, 3]"},{"value_type":"Tuple","value":"(1, 'a')"},{"value_type":"String","value":"k"},{"value_type":"UInt64","value":"1"},{"value_type":"Null","value":null},{"value_type":"Int64","value":"-5"},{"value_type":"Float64","value":1.5},{"value_type":"Bool","value":true},{"value_type":"String","value":"str"}]

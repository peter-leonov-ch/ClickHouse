{"mutations_sync":"1"}
{"mutations_sync":"2"}
{"optimize_throw_if_noop":"1"}
{"describe_compact_output":"1"}
{"max_threads":"3"}
{"distributed_ddl_task_timeout":"5"}
-- a Map-typed setting value is a JSON object (not an array of key/value tuples)
{"additional_table_filters":{"t1":{"value_type":"String","value":"x > 1"},"t2":{"value_type":"String","value":"y < 2"}}}
